# Where the browser sends API calls. Use /api so requests go through this app (required for
# the ported routes and on Vercel previews), or the Worker/Express URL directly.
NEXT_PUBLIC_API_BASE_URL=/api
# The Worker (or Express) that /api paths not answered by Next are forwarded to.
API_PROXY_TARGET=http://localhost:8787

# worker (default): ported routes forward to the Worker too, so data still comes from D1.
# next: ported routes answer from Supabase. Only switch at the Phase 3 cutover, or locally.
API_BACKEND=worker

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Postgres, server-only. Use the transaction pooler connection string (port 6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Cloudflare R2 through its S3 API (an R2 API token with Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clawholics-images
R2_PUBLIC_URL=https://images.clawholicsbymax.com

# Xendit (booking downpayments). XENDIT_CALLBACK_TOKEN is the callback verification token from
# Xendit's dashboard (Settings > Callbacks); webhooks without it are refused.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Where Xendit sends clients back after paying
FRONTEND_URL=https://clawholicsbymax.com

# Resend (booking emails) and the inbox that gets the admin copies
RESEND_API_KEY=
ADMIN_EMAIL=appointments@clawholicsbymax.com
